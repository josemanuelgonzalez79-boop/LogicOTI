    "@angular/router": "^21.2.18",
    "@primeuix/themes": "2.0.3",
    "primeicons": "7.0.0",
    "primeng": "21.1.9",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
