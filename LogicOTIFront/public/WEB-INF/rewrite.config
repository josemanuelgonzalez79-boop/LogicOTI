# Los archivos y directorios reales se entregan sin modificación.
RewriteCond %{REQUEST_PATH} !-f
RewriteCond %{REQUEST_PATH} !-d

# Una solicitud con extensión se considera un recurso, incluso si no existe.
# Así, un JavaScript, CSS, icono o imagen faltante conserva su 404 y nunca
# recibe index.html como respuesta.
RewriteCond %{REQUEST_PATH} !^/.*\.[^/]+$

# El resto son rutas internas de Angular y deben arrancar desde index.html.
RewriteRule ^/(.*)$ /index.html [L]
