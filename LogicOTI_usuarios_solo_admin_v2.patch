+    font-size: 1.6rem;
+  }
+}
+
+.summary-card--active > i {
+  color: #059669;
+  background: color-mix(in srgb, #10b981 14%, transparent);
+}
+.summary-card--admin > i {
+  color: #7c3aed;
+  background: color-mix(in srgb, #8b5cf6 14%, transparent);
+}
