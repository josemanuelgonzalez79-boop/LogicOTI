APP_NAME=LogicOTI
SERVER_PORT=3210
SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:postgresql://localhost:5432/LogicOTI
DB_USERNAME=postgres
DB_PASSWORD=CAMBIAR_LOCALMENTE

FRONTEND_ORIGIN=http://localhost:8080
FRONTEND_ORIGIN_ALT=http://127.0.0.1:8080

PLC_ENABLED=false
PLC_CONNECTION_STRING=logix:tcp://192.0.2.235?backplane=1&slot=0
PLC_TIMEOUT=5s
SIGNAL_STALE_AFTER=15s

CAMERAS_ENABLED=true
CAMERA_PLAYBACK_BASE_URL=https://logicoti.example.local/camera
CAMERA_AVAILABLE_STREAMS=oti-cam-01
CAMERA_ALERT_LINK_EXPIRATION_SECONDS=900

# Histórico Hikvision ISAPI. Usa una cuenta exclusiva con permiso de reproducción.
CAMERA_HISTORY_ENABLED=false
NVR_BASE_URL=http://192.0.2.18
NVR_USERNAME=
NVR_PASSWORD=
NVR_TIME_ZONE=America/Mazatlan
# El firmware V4.83.005 del DS-7632NXI-K2/16P espera hora local con sufijo Z.
NVR_LOCAL_TIME_AS_UTC=true
NVR_CONNECT_TIMEOUT=5s
NVR_RESPONSE_TIMEOUT=15s
NVR_MAX_SEARCH_HOURS=24
NVR_MAX_RESULTS=100
# Consultar franjas rojas de movimiento via SDK nativo de Hikvision (Windows x64).
# El script se obtiene con git pull; no incluya las DLL del fabricante en el repositorio.
CAMERA_MOTION_SDK_ENABLED=false
CAMERA_MOTION_SDK_DLL=
CAMERA_MOTION_SDK_SCRIPT=
CAMERA_MOTION_SDK_PORT=8000
CAMERA_MOTION_SDK_TIMEOUT=65s
CAMERA_HISTORY_PLAYBACK_ENABLED=false
MEDIAMTX_CONTROL_URL=http://127.0.0.1:9997
MEDIAMTX_CONTROL_TIMEOUT=5s
CAMERA_HISTORY_PLAYBACK_SESSION_TTL=2h
CAMERA_HISTORY_PLAYBACK_CLEANUP_MS=60000

# Movimiento PTZ. Habilitar tras comprobar el permiso de control en el NVR.
# Si se omiten estas dos variables, se usan NVR_USERNAME y NVR_PASSWORD.
CAMERA_PTZ_ENABLED=false
# CAMERA_PTZ_USERNAME=usuario_con_permiso_ptz
# CAMERA_PTZ_PASSWORD=CAMBIAR_LOCALMENTE
CAMERA_PTZ_ENDPOINT_MODE=direct
CAMERA_PTZ_CHANNELS=25,26,27,28
CAMERA_PTZ_SPEED=40
CAMERA_PTZ_PULSE_DURATION=350ms
CAMERA_PTZ_CONNECT_TIMEOUT=5s
CAMERA_PTZ_RESPONSE_TIMEOUT=5s

WEB_PUSH_ENABLED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:soporte@icap.com.mx
WEB_PUSH_MAX_ATTEMPTS=4
WEB_PUSH_INITIAL_RETRY_DELAY_SECONDS=30
WEB_PUSH_RETRY_BATCH_SIZE=100
WEB_PUSH_RETRY_POLL_MS=5000

SWAGGER_ENABLED=false
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRATION_SECONDS=3600

HISTORY_RETENTION_CRON=0 30 3 * * *
HISTORY_RETENTION_SCHEDULER_ZONE=America/Mazatlan
